{
  "manifest_version": 3,
  "name": "SKRBT Magnet Collector",
  "version": "1.0.4",
  "description": "Collect magnet links from open SKRBT detail tabs.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://skrbtso.top/*"
  ]
}
