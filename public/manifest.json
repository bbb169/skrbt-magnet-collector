{
  "manifest_version": 3,
  "name": "SKRBT Magnet Collector",
  "version": "1.0.0",
  "description": "Collect magnet links from open SKRBT detail tabs.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "clipboardWrite",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://skrbtso.top/*"
  ]
}
